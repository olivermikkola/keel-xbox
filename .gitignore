# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# certificates, keys, and local model/package binaries
*.pem
*.key
*.pfx
*.snk
*.cer
*.p12
*.gguf
*.onnx
*.safetensors
*.msix
*.appx
*.appxbundle

# Visual Studio / UWP build outputs
.vs/
*.user
*.suo
native/xbox/**/bin/
native/xbox/**/obj/
native/xbox/**/AppPackages/
native/xbox/**/BundleArtifacts/
native/xbox/KeelConsole.Xbox/ui/
native/xbox/KeelConsole.Xbox/KeelLlama.dll
native/xbox/KeelLlama/build*/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# copied from @wllama/wllama on postinstall
/public/wllama/
